# Secrets
.env
.env.*
!.env.example
*.local

# OS / editors
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Node
node_modules/
.next/
out/
coverage/
*.tsbuildinfo

# Supabase local
supabase/.branches/
supabase/.temp/

# Engine local output (the real raw archive lives in Supabase Storage)
engine/.archive/

# graphify cache (graph.json and GRAPH_REPORT.md stay tracked)
graphify-out/cache/
# graphify dated snapshots (the current graph at graphify-out/ is tracked)
graphify-out/20*/

# Benchmark photos: synthetic ones are regenerated by `npm run synthesize`; real ones stay
# out unless redacted and checked by Angad (D85)
benchmark/synthetic/images/
benchmark/receipts/*.jpg
benchmark/receipts/*.jpeg
benchmark/receipts/*.png
benchmark/receipts/*.heic
!benchmark/receipts/*.redacted.png

# EAS only: research outputs and the code graph never go into a build upload.
outputs/
graphify-out/
.ruff_cache/
